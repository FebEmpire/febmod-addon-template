{
	"schemaVersion": 1,
	"id": "febmod-addon-template",
	"version": "${version}",
	"name": "febmod addon template",
	"description": "A starter template for creating FebMod addons.",
	"authors": [
		"FebEmpire"
	],
	"contact": {
		"sources": "https://github.com/FebEmpire/febmod-addon-template"
	},
	"license": "CC0-1.0",
	"icon": "assets/febmod-addon-template/icon.png",
	"environment": "*",
	"entrypoints": {
		"fabric-datagen": [
			{
				"value": "com.example.febmod.addon.FebmodAddonTemplateDataGenerator",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"febmod-addon-template.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*",
		"febmod": "*"
	}
}